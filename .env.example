# Copy to .env for local use. Never commit the real .env.

# Optional: AI-assisted extraction for PDF and image documents. Without it, uploads still work
# and line items are entered in the review screen by hand.
ANTHROPIC_API_KEY=

# Optional: require sign-in locally (create a user with scripts/manage_users.py first).
# DASH_REQUIRE_LOGIN=1

# Production mode (HTTPS-only cookies, mandatory login, HSTS) needs at least:
# DASH_ENV=production
# DASH_SECRET_KEY=<64 hex characters>
# DASHBOARD_DB_PATH=/path/to/dashboard.db
# DASHBOARD_UPLOADS_PATH=/path/to/uploads
